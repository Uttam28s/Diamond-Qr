{
  "name": "diamond-qr",
  "homepage": "./",
  "version": "2.2.2",
  "//productName": "Top level, not just under build: Electron reads this for app.getName(), which is what names %APPDATA%\\Diamond QR. electron-builder strips its own build.productName from the packaged package.json, so putting it only there would leave the data folder named after `name` instead - and differently in dev than in production.",
  "productName": "Diamond QR",
  "description": "Diamond QR - offline packet scanning, lot sheets and Kapan records",
  "private": true,
  "scripts": {
    "icon": "node tools/make-icon.js",
    "start": "set \"PORT=3001\" && set \"REACT_APP_VERSION=%npm_package_version%\" && react-scripts start",
    "build": "set \"GENERATE_SOURCEMAP=false\" && set \"REACT_APP_VERSION=%npm_package_version%\" && react-scripts build && node tools/harden-build.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron-dev": "concurrently \"npm run start\" \"wait-on http://localhost:3001 && electron .\"",
    "postinstall": "electron-builder install-app-deps",
    "electron": "electron .",
    "dist": "npm run build && electron-builder",
    "smoke": "electron tools/smoke-test.js",
    "test:activation": "electron tools/activation-test.js",
    "test:journal": "electron tools/journal-growth-test.js",
    "verify:package": "node tools/verify-package.js",
    "recover:journal": "node tools/recover-journal.js",
    "check:backup": "node tools/check-backup.js",
    "devtools:secret": "node tools/devtools-secret.js",
    "license:keygen": "node tools/generate-keypair.js",
    "license:issue": "node tools/issue-license.js",
    "license:verify": "node tools/issue-license.js --verify"
  },
  "main": "public/electron.js",
  "author": {
    "name": "Zeonlabs",
    "email": "zeonlabs@outlook.com",
    "url": "https://zeonlabs.co"
  },
  "build": {
    "appId": "com.zeonlabs.diamond-qr",
    "productName": "Diamond QR",
    "copyright": "Copyright © 2026 Zeonlabs",
    "mac": {
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis",
        "msi"
      ]
    },
    "asar": true,
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/license-preload.js",
      "public/data-preload.js",
      "public/shared/**/*",
      "public/db/**/*",
      "public/net/**/*",
      "public/main/**/*",
      "public/activation.html",
      "public/splash.html",
      "public/license/**/*",
      "package.json",
      "!tools/**/*",
      "!node_modules/**/*",
      "node_modules/electron-is-dev/**/*",
      "node_modules/node-machine-id/**/*"
    ],
    "extraMetadata": {
      "name": "diamond-qr",
      "description": "Diamond QR - offline packet scanning, lot sheets and Kapan records"
    },
    "nsis": {
      "include": "assets/installer.nsh"
    },
    "directories": {
      "buildResources": "assets"
    }
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "node-machine-id": "^1.1.12"
  },
  "devDependencies": {
    "@babel/cli": "^7.11.6",
    "@babel/core": "^7.11.6",
    "@babel/node": "^7.10.5",
    "@babel/preset-react": "^7.18.6",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.6.1",
    "@mui/material": "^5.6.1",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.1.1",
    "@testing-library/user-event": "^13.5.0",
    "@types/express": "^4.17.2",
    "@types/lodash": "^4.14.149",
    "antd": "^4.24.5",
    "axios": "^0.27.2",
    "child_process": "^1.0.2",
    "crypto": "^1.0.1",
    "electron": "^18.0.4",
    "electron-browser-storage": "^1.0.7",
    "electron-builder": "^23.0.3",
    "electron-packager": "^15.4.0",
    "electron-rebuild": "^1.10.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "path": "^0.12.7",
    "react": "^18.0.0",
    "react-bootstrap": "^2.4.0",
    "react-dom": "^18.0.0",
    "react-grid-layout": "^1.3.4",
    "react-hook-form": "^7.33.1",
    "react-notifications": "^1.7.3",
    "react-router-dom": "^6.3.0",
    "react-script": "^2.0.5",
    "react-scripts": "5.0.1",
    "react-spreadsheet": "^0.7.5",
    "react-table": "^7.8.0",
    "react-tippy": "^1.4.0",
    "react-to-print": "^2.14.10",
    "sass": "^1.89.2",
    "styled-components": "^5.3.6",
    "tslint": "^6.0.0"
  }
}
